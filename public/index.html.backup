<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<meta name="description" content="Clica, Compra e Ri — produtos selecionados, ofertas e achados que fazem sentido comprar.">

<title>Clica, Compra e Ri | Achados e Ofertas</title>

<style>
:root{
  --yellow:#ffd21c;
  --yellow-dark:#f2bd00;
  --black:#111315;
  --black-2:#191c20;
  --gray:#f4f5f6;
  --gray-2:#e7e9ec;
  --text:#15171a;
  --muted:#73777d;
  --white:#fff;
  --radius:22px;
  --shadow:0 10px 35px rgba(0,0,0,.07);
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Inter,Arial,Helvetica,sans-serif;
  background:#fff;
  color:var(--text);
  line-height:1.45;
}

img{
  max-width:100%;
  display:block;
}

a{
  color:inherit;
  text-decoration:none;
}

button,
input{
  font:inherit;
}

.wrap{
  width:min(1180px,calc(100% - 40px));
  margin:auto;
}

/* ================= HEADER ================= */

header{
  position:sticky;
  top:0;
  z-index:100;
  background:rgba(255,255,255,.94);
  backdrop-filter:blur(16px);
  border-bottom:1px solid #eceef0;
}

.header-inner{
  min-height:78px;
  display:flex;
  align-items:center;
  gap:28px;
}

.logo{
  width:92px;
  height:58px;
  object-fit:contain;
  flex-shrink:0;
}

.nav{
  display:flex;
  align-items:center;
  gap:26px;
  font-size:14px;
  font-weight:700;
}

.nav a{
  transition:.2s;
}

.nav a:hover{
  color:#d39e00;
}

.search{
  margin-left:auto;
  width:min(340px,32vw);
  height:46px;
  background:#f4f5f6;
  border:1px solid #e6e8ea;
  border-radius:14px;
  display:flex;
  align-items:center;
  padding-left:14px;
  overflow:hidden;
}

.search input{
  width:100%;
  height:100%;
  border:0;
  outline:0;
  background:transparent;
  padding:0 10px;
  color:var(--text);
}

.search button{
  width:48px;
  height:100%;
  border:0;
  background:var(--yellow);
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
}

.search button img{
  width:21px;
  height:21px;
  object-fit:contain;
}

.cart{
  width:44px;
  height:44px;
  border:1px solid #e5e7e9;
  border-radius:14px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#fff;
  cursor:pointer;
}

.cart img{
  width:23px;
  height:23px;
  object-fit:contain;
}

/* ================= HERO VALUE PROPOSITION ================= */

.hero-proposition{
  margin-top:40px;
  margin-bottom:32px;
  text-align:center;
  animation:fadeInDown .6s ease-out;
}

.hero-proposition h2{
  font-size:clamp(24px,5vw,40px);
  color:var(--black);
  line-height:1.2;
  letter-spacing:-1px;
  margin-bottom:12px;
  font-weight:900;
}

.hero-proposition p{
  color:var(--muted);
  font-size:clamp(14px,2.5vw,16px);
  max-width:600px;
  margin:0 auto 24px;
  line-height:1.5;
}

.hero-value-points{
  display:flex;
  flex-wrap:wrap;
  justify-content:center;
  gap:16px 32px;
  font-size:13px;
  font-weight:600;
  color:var(--text);
}

.value-point{
  display:flex;
  align-items:center;
  gap:8px;
}

.value-point::before{
  content:"✓";
  display:flex;
  align-items:center;
  justify-content:center;
  width:20px;
  height:20px;
  background:var(--yellow);
  border-radius:50%;
  color:var(--black);
  font-weight:900;
  font-size:11px;
  flex-shrink:0;
}

@keyframes fadeInDown {
  from {
    opacity:0;
    transform:translateY(-20px);
  }
  to {
    opacity:1;
    transform:translateY(0);
  }
}

/* ================= HERO BANNER ================= */

.hero-banner-wrapper{
  position:relative;
  margin-bottom:8px;
  animation:fadeInUp .7s ease-out .2s both;
}

.hero-new{
  width:100%;
  border-radius:26px;
  overflow:hidden;
  box-shadow:0 20px 60px rgba(0,0,0,.08);
  transition:transform .3s ease, box-shadow .3s ease;
}

.hero-new img{
  display:block;
  width:100%;
  height:auto;
}

.hero-new:hover{
  transform:translateY(-4px);
  box-shadow:0 24px 72px rgba(0,0,0,.12);
}

@keyframes fadeInUp {
  from {
    opacity:0;
    transform:translateY(20px);
  }
  to {
    opacity:1;
    transform:translateY(0);
  }
}

/* ================= CTA BELOW BANNER ================= */

.hero-cta-section{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:16px;
  padding:28px 0 8px;
  animation:fadeInUp .7s ease-out .4s both;
}

.cta-primary{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:52px;
  padding:0 32px;
  border-radius:14px;
  background:var(--yellow);
  color:var(--black);
  font-size:15px;
  font-weight:900;
  transition:.2s;
  border:2px solid var(--yellow);
  cursor:pointer;
  box-shadow:0 6px 20px rgba(255,210,28,.25);
}

.cta-primary:hover{
  transform:translateY(-3px);
  background:#ffe04d;
  border-color:#ffe04d;
  box-shadow:0 10px 28px rgba(255,210,28,.35);
}

.cta-primary:active{
  transform:translateY(-1px);
}

.cta-secondary{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:52px;
  padding:0 28px;
  border-radius:14px;
  background:transparent;
  color:var(--text);
  font-size:15px;
  font-weight:700;
  transition:.2s;
  border:2px solid #e3e5e8;
  cursor:pointer;
}

.cta-secondary:hover{
  border-color:var(--yellow);
  background:#fffbea;
  color:var(--black);
}

/* ================= SECTIONS ================= */

section{
  padding-top:72px;
}

.section-head{
  display:flex;
  align-items:end;
  justify-content:space-between;
  margin-bottom:22px;
}

.section-head h2{
  font-size:27px;
  letter-spacing:-1px;
}

.section-head p{
  color:var(--muted);
  font-size:13px;
  margin-top:5px;
}

.see-all{
  font-size:12px;
  font-weight:800;
}

/* ================= CATEGORIES ================= */

.categories{
  display:grid;
  grid-template-columns:repeat(8,1fr);
  gap:12px;
}

.category{
  border:1px solid #e7e9eb;
  border-radius:18px;
  min-height:112px;
  background:#fff;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:10px;
  transition:.2s;
}

.category:hover{
  transform:translateY(-3px);
  box-shadow:var(--shadow);
  border-color:#ddd;
}

.category-image{
  width:52px;
  height:52px;
  object-fit:contain;
}

.category span{
  font-size:11px;
  font-weight:800;
}

/* ================= PRODUCTS ================= */

.products{
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:14px;
}

.product{
  border:1px solid #e3e5e8;
  border-radius:20px;
  overflow:hidden;
  background:#fff;
  transition:.22s;
}

.product:hover{
  transform:translateY(-4px);
  box-shadow:var(--shadow);
}

.product-image{
    height:230px;
    background:#eef1f4;
    position:relative;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:10px;
    overflow:hidden;
}

.product-image img{
    position:relative;
    z-index:1;
    width:100%;
    height:100%;
    object-fit:contain;
    transform:scale(1.18);
}

.badge{
  position:absolute;
  left:10px;
  top:10px;
  background:var(--yellow);
  color:#111;
  padding:6px 9px;
  border-radius:7px;
  font-size:9px;
  font-weight:900;
  text-transform:uppercase;
}

.product-info{
  padding:14px;
}

.product-name{
  font-size:13px;
  font-weight:900;
  margin-bottom:4px;
}

.product-desc{
  color:var(--muted);
  font-size:10px;
  min-height:30px;
}

.rating{
  margin-top:10px;
  color:#d49e00;
  font-size:10px;
}

.price{
  margin-top:7px;
}

.price strong{
  font-size:18px;
}

.old-price{
  color:#a1a5aa;
  text-decoration:line-through;
  font-size:9px;
  margin-left:5px;
}

.product-btn{
  width:100%;
  border:0;
  height:40px;
  margin-top:12px;
  border-radius:12px;
  background:var(--yellow);
  color:#111;
  font-size:11px;
  font-weight:900;
  cursor:pointer;
  transition:.2s;
}

.product-btn:hover{
  background:#f5c500;
}

/* ================= OFFER BANNER ================= */

.offer-banner{
  min-height:150px;
  border-radius:24px;
  overflow:hidden;
  background:var(--black);
  position:relative;
  display:flex;
  align-items:center;
  padding:32px 40px;
}

.offer-content{
  position:relative;
  z-index:3;
}

.offer-banner h2{
  color:#fff;
  font-size:30px;
  letter-spacing:-1px;
}

.offer-banner h2 span{
  color:var(--yellow);
}

.offer-banner p{
  color:#8e949a;
  font-size:12px;
  margin:5px 0 15px;
}

.primary-btn{
  width:max-content;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:46px;
  padding:0 24px;
  border-radius:14px;
  background:var(--yellow);
  color:#111;
  font-size:14px;
  font-weight:900;
  transition:.2s;
}

.primary-btn:hover{
  transform:translateY(-2px);
  background:#ffe04d;
}

.offer-circle{
  position:absolute;
  width:230px;
  height:230px;
  border-radius:50%;
  background:var(--yellow);
  left:52%;
  top:-40px;
}

.offer-number{
  margin-left:auto;
  position:relative;
  z-index:3;
  color:#fff;
  text-align:right;
}

.offer-number small{
  font-size:10px;
  text-transform:uppercase;
  font-weight:900;
}

.offer-number strong{
  display:block;
  font-size:54px;
  line-height:.9;
}

/* ================= FOOTER ================= */

footer{
  margin-top:90px;
  background:var(--black);
  color:#fff;
  padding:55px 0 25px;
}

.footer-grid{
  display:grid;
  grid-template-columns:1.4fr 1fr 1fr 1.4fr;
  gap:40px;
}

.footer-logo{
  width:82px;
  height:58px;
  object-fit:contain;
  background:#fff;
  border-radius:12px;
  padding:5px;
  margin-bottom:14px;
}

.footer p{
  color:#81868c;
  font-size:11px;
  max-width:230px;
}

.footer h3{
  font-size:12px;
  margin-bottom:14px;
}

.footer a{
  display:block;
  color:#81868c;
  font-size:11px;
  margin-bottom:9px;
}

.newsletter p{
  margin-bottom:12px;
}

.newsletter-form{
  display:flex;
  height:42px;
}

.newsletter-form input{
  flex:1;
  min-width:0;
  border:0;
  outline:0;
  background:#202328;
  color:#fff;
  padding:0 12px;
  border-radius:10px 0 0 10px;
}

.newsletter-form button{
  width:48px;
  border:0;
  background:var(--yellow);
  cursor:pointer;
  font-weight:900;
  border-radius:0 10px 10px 0;
}

.copyright{
  border-top:1px solid #282b2f;
  margin-top:40px;
  padding-top:18px;
  color:#62676d;
  font-size:9px;
}

/* ================= MOBILE ================= */

@media(max-width:900px){

  .wrap{
    width:min(100% - 28px,600px);
  }

  .header-inner{
    min-height:70px;
    gap:10px;
    flex-wrap:wrap;
    padding:8px 0;
  }

  .logo{
    width:72px;
    height:52px;
  }

  .nav{
    display:none;
  }

  .search{
    order:3;
    width:100%;
    margin-left:0;
    height:42px;
  }

  .cart{
    margin-left:auto;
  }

  .hero-proposition{
    margin-top:28px;
    margin-bottom:20px;
  }

  .hero-proposition h2{
    font-size:28px;
  }

  .hero-proposition p{
    font-size:14px;
  }

  .hero-value-points{
    gap:12px 20px;
    font-size:12px;
  }

  .hero-cta-section{
    flex-direction:column;
    width:100%;
    gap:12px;
    padding:20px 0;
  }

  .cta-primary,
  .cta-secondary{
    width:100%;
  }

  section{
    padding-top:48px;
  }

  .section-head h2{
    font-size:22px;
  }

  .categories{
    display:flex;
    overflow-x:auto;
    gap:10px;
    padding-bottom:7px;
    scrollbar-width:none;
  }

  .categories::-webkit-scrollbar{
    display:none;
  }

  .category{
    flex:0 0 92px;
    min-height:100px;
  }

  .products{
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:10px;
  }

  .product-image{
    height:155px;
    padding:14px;
  }

  .product-info{
    padding:11px;
  }

  .product-name{
    font-size:12px;
  }

  .product-desc{
    font-size:9px;
  }

  .price strong{
    font-size:16px;
  }

  .product-btn{
    height:38px;
  }

  .offer-banner{
    min-height:190px;
    padding:25px;
  }

  .offer-banner h2{
    font-size:23px;
    max-width:220px;
  }

  .offer-circle{
    width:180px;
    height:180px;
    left:55%;
  }

  .offer-number{
    position:absolute;
    right:20px;
    bottom:18px;
  }

  .offer-number strong{
    font-size:38px;
  }

  .footer-grid{
    grid-template-columns:1fr 1fr;
    gap:30px 20px;
  }

  .newsletter{
    grid-column:1/-1;
  }
}

@media(max-width:430px){

  .hero-proposition h2{
    font-size:22px;
  }

  .hero-proposition p{
    font-size:13px;
  }

  .hero-value-points{
    gap:10px 16px;
  }

  .products{
    grid-template-columns:1fr 1fr;
  }

  .product-image{
    height:135px;
  }

  .product-desc{
    min-height:42px;
  }

  .footer-grid{
    grid-template-columns:1fr;
  }
}

/* =========================================
   PRODUCT CARD ENHANCEMENTS
   ========================================= */

.product-card {
  transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
}
.product-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 14px 30px rgba(0,0,0,.10);
  border-color: #ffd21c;
}

.product-image {
  overflow: hidden;
}
.product-image img {
  transition: transform .35s ease;
}
.product-card:hover .product-image img {
  transform: scale(1.3);
}

.product-card a, .product-card button {
  transition: filter .2s ease, transform .2s ease;
}
.product-card a:hover, .product-card button:hover {
  filter: brightness(.92);
  transform: translateY(-1px);
}
.product-card a:active, .product-card button:active {
  transform: translateY(0);
}

/* =========================================
   CATEGORY CARD ENHANCEMENTS
   ========================================= */

.category-card {
  position: relative;
  overflow: hidden;
  transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease, background .25s ease;
}

.category-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 12px 26px rgba(0,0,0,.10);
  border-color: #ffd21c;
  background: linear-gradient(180deg,#ffffff 0%,#fffbea 100%);
}

.category-card::before {
  content: "";
  position: absolute;
  left: 50%; top: 38%;
  width: 110px; height: 110px;
  transform: translate(-50%,-50%) scale(.4);
  background: radial-gradient(circle, rgba(255,210,28,.28) 0%, rgba(255,210,28,0) 70%);
  opacity: 0;
  transition: opacity .3s ease, transform .3s ease;
  pointer-events: none;
}
.category-card:hover::before {
  opacity: 1;
  transform: translate(-50%,-50%) scale(1);
}

.category-card > :first-child {
  transition: transform .35s cubic-bezier(.34,1.56,.64,1);
}
.category-card:hover > :first-child {
  transform: scale(1.18) rotate(-6deg);
}

.category-card::after {
  content: "→";
  position: absolute;
  top: 10px; right: 12px;
  font-size: 15px;
  font-weight: 700;
  color: #e8be00;
  opacity: 0;
  transform: translateX(-8px);
  transition: opacity .25s ease, transform .25s ease;
}
.category-card:hover::after {
  opacity: 1;
  transform: translateX(0);
}

.category-card > :last-child {
  position: relative;
}
.category-card > :last-child::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -6px;
  transform: translateX(-50%);
  width: 0;
  height: 3px;
  border-radius: 2px;
  background: #ffd21c;
  transition: width .25s ease;
}
.category-card:hover > :last-child::after {
  width: 26px;
}
</style>
</head>

<body>

<header>
  <div class="wrap header-inner">

    <a href="/" aria-label="Clica, Compra e Ri">
      <img class="logo" src="/logo.png" alt="Clica, Compra e Ri">
    </a>

    <nav class="nav">
      <a href="#inicio">Início</a>
      <a href="#ofertas">Ofertas</a>
      <a href="#destaques">Mais vendidos</a>
      <a href="#categorias">Categorias</a>
      <a href="#novidades">Novidades</a>
    </nav>

    <form class="search" id="searchForm">
      <input
        id="searchInput"
        type="search"
        placeholder="Buscar produtos"
        aria-label="Buscar produtos"
      >
      <button type="submit" aria-label="Pesquisar">
        <img src="/assets/busca.png" alt="">
      </button>
    </form>

    <button class="cart" aria-label="Carrinho">
      <img src="/assets/carrinho.png" alt="">
    </button>

  </div>
</header>


<main>

<section class="wrap" id="inicio">

<div class="hero-proposition">
  <h2>Compras que fazem sentido</h2>
  <p>Produtos selecionados, ofertas reais e achados que você realmente vai usar.</p>
  
  <div class="hero-value-points">
    <div class="value-point">Produtos verificados</div>
    <div class="value-point">Ofertas autênticas</div>
    <div class="value-point">Frete em todo Brasil</div>
  </div>
</div>

<div class="hero-banner-wrapper">
  <div class="hero-new">
    <img
      src="/assets/banner-clica-compra.png"
      alt="Clica, Compra e Ri"
    >
  </div>
</div>

<div class="hero-cta-section">
  <a href="#destaques" class="cta-primary">Começar a comprar</a>
  <a href="#categorias" class="cta-secondary">Explorar categorias</a>
</div>

</section>


<section class="wrap" id="categorias">

  <div class="section-head">
    <div>
      <h2>Explore por categoria</h2>
      <p>Encontre rapidamente o que procura.</p>
    </div>

    <a class="see-all" href="#destaques">Ver todos</a>
  </div>

  <div class="categories">

    <a class="category" data-category="Casa" href="#destaques">
      <img class="category-image" src="/assets/casa.png" alt="Casa">
      <span>Casa</span>
    </a>

    <a class="category" data-category="Tecnologia" href="#destaques">
      <img class="category-image" src="/assets/tecnologia.png" alt="Tecnologia">
      <span>Tecnologia</span>
    </a>

    <a class="category" data-category="Beleza" href="#destaques">
      <img class="category-image" src="/assets/beleza.png" alt="Beleza">
      <span>Beleza</span>
    </a>

    <a class="category" data-category="Moda" href="#destaques">
      <img class="category-image" src="/assets/moda.png" alt="Moda">
      <span>Moda</span>
    </a>

    <a class="category" data-category="Esportes" href="#destaques">
      <img class="category-image" src="/assets/esportes.png" alt="Esportes">
      <span>Esportes</span>
    </a>

    <a class="category" data-category="Presentes" href="#destaques">
      <img class="category-image" src="/assets/presentes.png" alt="Presentes">
      <span>Presentes</span>
    </a>

    <a class="category" data-category="Pet" href="#destaques">
      <img class="category-image" src="/assets/pet.png" alt="Pet">
      <span>Pet</span>
    </a>

    <a class="category" data-category="Automotivo" href="#destaques">
      <img class="category-image" src="/assets/automotivo.png" alt="Automotivo">
      <span>Automotivo</span>
    </a>

  </div>

</section>


<section class="wrap" id="destaques">

  <div class="section-head">
    <div>
      <h2>Produtos em destaque</h2>
      <p>Uma seleção inicial para você conhecer a loja.</p>
    </div>

    <a class="see-all" href="#destaques">Ver todos</a>
  </div>

  <div class="products" id="productsGrid"></div>

</section>


<section class="wrap" id="ofertas">

  <div class="offer-banner">

    <div class="offer-content">

      <h2>
        Ofertas que fazem
        <span>sentido.</span>
      </h2>

      <p>
        Uma seleção especial de produtos com condições interessantes.
      </p>

      <a href="#destaques" class="primary-btn">
        Ver ofertas
      </a>

    </div>

    <div class="offer-circle"></div>

    <div class="offer-number">
      <small>Seleção especial</small>
      <strong>50%</strong>
    </div>

  </div>

</section>


<section class="wrap" id="novidades">

  <div class="section-head">
    <div>
      <h2>Mais procurados</h2>
      <p>Produtos que merecem sua atenção.</p>
    </div>

    <a class="see-all" href="#destaques">Ver todos</a>
  </div>

  <div class="products" id="popularGrid"></div>

</section>

</main>


<footer>

  <div class="wrap">

    <div class="footer-grid">

      <div>
        <img
          class="footer-logo"
          src="/logo.png"
          alt="Clica, Compra e Ri"
        >

        <p>
          Achados interessantes para você descobrir,
          comparar e comprar.
        </p>
      </div>

      <div>
        <h3>Institucional</h3>
        <a href="/termos.html">Termos de uso</a>
        <a href="/privacidade.html">Política de privacidade</a>
        <a href="#destaques">Fale conosco</a>
      </div>

      <div>
        <h3>Categorias</h3>
        <a href="#categorias">Casa</a>
        <a href="#categorias">Tecnologia</a>
        <a href="#categorias">Beleza</a>
        <a href="#categorias">Moda</a>
      </div>

      <div class="newsletter">

        <h3>Receba novidades</h3>

        <p>
          Ofertas e novos achados direto no seu e-mail.
        </p>

        <form class="newsletter-form" onsubmit="return false;">
          <input
            type="email"
            placeholder="Seu e-mail"
            aria-label="Seu e-mail"
          >

          <button type="submit" aria-label="Cadastrar">
            →
          </button>
        </form>

      </div>

    </div>

    <div class="copyright">
      © 2026 Clica, Compra e Ri. Todos os direitos reservados.
    </div>

  </div>

</footer>


<script>

const products = [

  {
    name:"Air Fryer 4L",
    description:"Cozinha prática para todos os dias",
    price:"R$ 249,90",
    oldPrice:"R$ 349,90",
    category:"Casa",
    badge:"Mais vendido",
    image:"/assets/produto-airfryer.png",
    link:"#"
  },

  {
    name:"Smartwatch",
    description:"Tecnologia e estilo no pulso",
    price:"R$ 159,90",
    oldPrice:"R$ 220,90",
    category:"Tecnologia",
    badge:"Oferta",
    image:"/assets/produto-smartwatch.png",
    link:"#"
  },

  {
    name:"Fone Bluetooth",
    description:"Liberdade para ouvir onde quiser",
    price:"R$ 89,90",
    oldPrice:"R$ 129,90",
    category:"Tecnologia",
    badge:"",
    image:"/assets/produto-fone.png",
    link:"#"
  },

  {
    name:"Liquidificador 1200W",
    description:"Potência para sua rotina",
    price:"R$ 189,90",
    oldPrice:"R$ 260,00",
    category:"Casa",
    badge:"",
    image:"/assets/produto-liquidificador.png",
    link:"#"
  },

  {
    name:"Tênis Casual",
    description:"Conforto para todos os dias",
    price:"R$ 179,90",
    oldPrice:"R$ 249,90",
    category:"Moda",
    badge:"Lançamento",
    image:"/assets/produto-tenis.png",
    link:"#"
  },

  {
    name:"Kit de Pincéis",
    description:"Para sua rotina de beleza",
    price:"R$ 69,90",
    oldPrice:"R$ 99,90",
    category:"Beleza",
    badge:"",
    image:"/assets/produto-beleza.png",
    link:"#"
  },

  {
    name:"Organizador Multifuncional",
    description:"Mais espaço e organização",
    price:"R$ 49,90",
    oldPrice:"R$ 69,90",
    category:"Casa",
    badge:"",
    image:"/assets/produto-organizador.png",
    link:"#"
  },

  {
    name:"Projetor Portátil",
    description:"Cinema em qualquer lugar",
    price:"R$ 399,90",
    oldPrice:"R$ 599,90",
    category:"Tecnologia",
    badge:"Desconto",
    image:"/assets/produto-projetor.png",
    link:"#"
  },

  {
    name:"Almofada Ergonômica",
    description:"Conforto para seu descanso",
    price:"R$ 79,90",
    oldPrice:"R$ 119,90",
    category:"Casa",
    badge:"",
    image:"/assets/produto-almofada.png",
    link:"#"
  },

  {
    name:"Mochila Tática",
    description:"Resistência e funcionalidade",
    price:"R$ 129,90",
    oldPrice:"R$ 179,90",
    category:"Moda",
    badge:"",
    image:"/assets/produto-mochila.png",
    link:"#"
  }

];

function renderProducts(containerId, items = products) {
  const container = document.getElementById(containerId);
  container.innerHTML = items.map(product => `
    <a href="${product.link}" class="product product-card" style="display:flex; flex-direction:column;">
      <div class="product-image">
        <img src="${product.image}" alt="${product.name}">
        ${product.badge ? `<span class="badge">${product.badge}</span>` : ''}
      </div>
      <div class="product-info">
        <div class="product-name">${product.name}</div>
        <div class="product-desc">${product.description}</div>
        <div class="rating">5.0 ★ (127 avaliações)</div>
        <div class="price">
          <strong>${product.price}</strong>
          <span class="old-price">${product.oldPrice}</span>
        </div>
        <button class="product-btn" onclick="event.preventDefault(); event.stopPropagation();">
          Adicionar ao carrinho
        </button>
      </div>
    </a>
  `).join('');
}

document.addEventListener('DOMContentLoaded', () => {
  renderProducts('productsGrid', products.slice(0, 5));
  renderProducts('popularGrid', products.slice(5, 10));
});

function upgradeCards(){
  document.querySelectorAll('.product-card').forEach(function(card){

    var imgBox = card.querySelector('.product-image');
    if(imgBox && !card.querySelector('.fav-btn')){
      var fav = document.createElement('button');
      fav.type = 'button';
      fav.className = 'fav-btn';
      fav.innerHTML = '♡';
      fav.title = 'Favoritar';
      fav.style.position = 'absolute';
      fav.style.right = '12px';
      fav.style.top = '12px';
      fav.style.width = '36px';
      fav.style.height = '36px';
      fav.style.background = '#fff';
      fav.style.border = 'none';
      fav.style.borderRadius = '50%';
      fav.style.cursor = 'pointer';
      fav.style.zIndex = '2';
      fav.style.fontSize = '18px';
      fav.style.display = 'flex';
      fav.style.alignItems = 'center';
      fav.style.justifyContent = 'center';
      fav.style.transition = '.2s';
      fav.addEventListener('click', function(e){
        e.preventDefault();
        e.stopPropagation();
        fav.classList.toggle('active');
        fav.style.background = fav.classList.contains('active') ? '#ffd21c' : '#fff';
      });
      imgBox.appendChild(fav);
    }

    if(!card.querySelector('.discount-badge')){
      var current = null, old = null;
      card.querySelectorAll('*').forEach(function(el){
        if(el.children.length === 0 && /R\$\s?\d/.test(el.textContent)){
          var deco = getComputedStyle(el).textDecorationLine || '';
          if(deco.indexOf('line-through') !== -1){ old = el; } else { current = el; }
        }
      });
      function parsePrice(el){
        var m = el.textContent.replace(/\./g,'').replace(',','.').match(/\d+(\.\d+)?/);
        return m ? parseFloat(m[0]) : 0;
      }
      if(current && old){
        var pc = parsePrice(current), po = parsePrice(old);
        if(po > pc && pc > 0){
          var badge = document.createElement('span');
          badge.className = 'discount-badge';
          badge.textContent = '-' + Math.round((1 - pc/po) * 100) + '%';
          badge.style.position = 'absolute';
          badge.style.top = '10px';
          badge.style.left = '10px';
          badge.style.background = '#ffd21c';
          badge.style.padding = '4px 8px';
          badge.style.borderRadius = '6px';
          badge.style.fontSize = '11px';
          badge.style.fontWeight = '900';
          badge.style.color = '#111';
          current.parentNode.insertBefore(badge, current.nextSibling);
        }
      }
    }

  });
}
document.addEventListener('DOMContentLoaded', upgradeCards);
window.addEventListener('load', upgradeCards);

</script>

</body>
</html>

